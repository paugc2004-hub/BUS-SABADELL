{
  "name": "bus-sabadell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data:build": "pnpm --filter @bus/data-pipeline build",
    "data:audit": "pnpm --filter @bus/data-pipeline run audit",
    "data:streets": "pnpm --filter @bus/data-pipeline run streets",
    "data:refresh": "pnpm --filter @bus/data-pipeline build --refresh",
    "dev": "pnpm --filter @bus/web dev",
    "dev:api": "pnpm --filter @bus/api dev",
    "build": "pnpm --filter @bus/web build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @bus/web e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^3.23.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11"
  }
}
