FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY . .
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm install --frozen-lockfile && pnpm --filter @bus/web exec vite build

FROM nginx:1.27-alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
RUN printf 'server {\n listen 80;\n root /usr/share/nginx/html;\n location / { try_files $uri /index.html; }\n location /data/ { add_header Cache-Control "public, max-age=600"; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
