# --- apps/web (Vite) ---
# URL de l'API. Buida = la web simula sola al navegador (recomanat per a la demo).
VITE_API_URL=

# --- apps/api ---
PORT=8787
# Orígens permesos per CORS (separats per comes)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Proveïdor de vehicles: sim (per defecte) | gtfsrt
PROVIDER=sim
# Només amb PROVIDER=gtfsrt: feed GTFS-Realtime (URL o fitxer .pb)
GTFS_RT_VEHICLES=
GTFS_RT_TRIPS=
GTFS_RT_POLL_MS=10000
# Ruta a network.json (per defecte apps/web/public/data/network.json)
NETWORK_PATH=
